# Copy to .env and fill in. All variables are prefixed BOT_; nested settings use __.

# --- required to connect ---
BOT_TOKEN=

# --- common ---
# BOT_APPLICATION_ID=123456789012345678
# BOT_OWNER_IDS=[209081432956600320]   # who /dev commands + bot.is_owner trust; JSON list
# BOT_LOG_LEVEL=INFO
# BOT_LOG_FORMAT=text            # text | rich | json
# BOT_PRESENCE_TEXT=with cogs

# Enable classic "!"-prefix message commands. Off by default (slash-only, and the
# privileged message-content intent is not required). If you turn this on, also
# set BOT_INTENTS__MESSAGE_CONTENT=true.
# BOT_MESSAGE_COMMANDS=false
# BOT_COMMAND_PREFIX=!

# Instant command sync to specific guilds during development (JSON list).
# Leave unset for a (slower) global sync.
# BOT_DEV_GUILD_IDS=[123456789012345678]

# Extra extension packages to load alongside botbase.ext (JSON list).
# BOT_EXTENSION_PACKAGES=["botbase.ext","mybot.ext"]
# BOT_DISABLED_EXTENSIONS=["meta"]
# BOT_STRICT_EXTENSION_LOADING=false

# --- privileged intents (must also be enabled in the Developer Portal) ---
# BOT_INTENTS__MEMBERS=false
# BOT_INTENTS__MESSAGE_CONTENT=false
# BOT_INTENTS__PRESENCES=false

# --- optional database (needs: pip install 'discord-bot-base[db]') ---
# BOT_DATABASE__URL=sqlite+aiosqlite:///bot.sqlite3
# BOT_DATABASE__ECHO=false
# BOT_DATABASE__AUTO_CREATE=true
# BOT_DATABASE__RUN_MIGRATIONS=false
