# syntax=docker/dockerfile:1

# ---- build: resolve deps + install the project into /app/.venv ----------------
FROM ghcr.io/astral-sh/uv:python{{ python_floor }}-trixie-slim AS build

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Dependency layer — cached until pyproject.toml / uv.lock change.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

# Project layer.
COPY . .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable

# ---- runtime: just the venv{% if use_database %} + Alembic assets{% endif %}, non-root -----------------------
FROM python:{{ python_floor }}-slim-trixie AS runtime

LABEL org.opencontainers.image.title="{{ project_slug }}" \
      org.opencontainers.image.description="{{ project_name }}" \
      org.opencontainers.image.source="https://github.com/{{ github_owner }}/{{ project_slug }}" \
      org.opencontainers.image.licenses="MIT"

# Fixed uid/gid 10001 — the host convention (discord-bot-base docs: Hosting): each
# bot's ./data is chowned to it and bind-mounted at /app/data, the only writable path.
RUN groupadd --system --gid 10001 bot \
 && useradd --system --uid 10001 --gid bot --home /app --no-create-home bot \
 && mkdir -p /app/data \
 && chown bot:bot /app/data

WORKDIR /app
COPY --from=build /app/.venv /app/.venv
{%- if use_database %}
COPY --from=build /app/alembic /app/alembic
COPY --from=build /app/alembic.ini /app/alembic.ini
{%- endif %}

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER bot

# Config comes from the environment (`--env-file .env` or individual BOT_* vars).
# `docker run <img>` starts the bot; `docker run --entrypoint botbase <img> version`
# (or `db upgrade`, ...) for the management CLI.
ENTRYPOINT ["{{ project_slug }}"]
