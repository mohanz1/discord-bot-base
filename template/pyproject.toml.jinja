[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_name }} — a Discord bot built on discord-bot-base."
readme = "README.md"
license = "MIT"
requires-python = ">={{ python_floor }}"
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
dependencies = [
{%- if use_database %}
    "discord-bot-base[db]>=0.1",
{%- else %}
    "discord-bot-base>=0.1",
{%- endif %}
]

[project.optional-dependencies]
speedups = ["discord-bot-base[speedups]>=0.1"]

[project.scripts]
{{ project_slug }} = "{{ package_import_name }}.__main__:main"

[project.urls]
Repository = "https://github.com/{{ github_owner }}/{{ project_slug }}"

[dependency-groups]
dev = [
    "pytest>=8.2",
    "pytest-asyncio>=0.24",
    "pytest-cov>=5.0",
    "ruff==0.16.6",
    "ty==0.0.78",
]

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_import_name }}"]

[tool.ruff]
line-length = 120
target-version = "py{{ python_floor | replace('.', '') }}"
src = ["src", "tests"]
{%- if use_database %}
extend-exclude = ["alembic/versions"]
{%- endif %}

[tool.ruff.lint]
select = [
    "E", "W", "F", "I", "N", "D", "UP", "ANN", "ASYNC", "S", "B", "A", "C4",
    "DTZ", "EM", "G", "PIE", "PT", "RET", "SIM", "TID", "TC", "PTH", "PL",
    "TRY", "PERF", "RUF",
]
ignore = ["D203", "D213", "COM812", "ISC001", "TRY003", "PLC0415"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101", "S106", "D", "ANN", "PLR2004", "TC", "EM"]
{%- if use_database %}
"alembic/**" = ["D", "ANN", "INP001", "ERA001"]
{%- endif %}
"src/{{ package_import_name }}/__init__.py" = ["F401"]

[tool.ruff.lint.pydocstyle]
convention = "numpy"

[tool.ty.environment]
python-version = "{{ python_floor }}"

[tool.ty.src]
include = ["src"]
{%- if use_database %}
exclude = ["alembic"]
{%- endif %}

[tool.pytest.ini_options]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
pythonpath = ["."]
testpaths = ["tests"]
addopts = "-ra --strict-markers --cov={{ package_import_name }} --cov-report=term-missing"
filterwarnings = [
    "error",
    "ignore:.*iscoroutinefunction.*:DeprecationWarning",
    "ignore:.*AbstractEventLoopPolicy.*:DeprecationWarning",
]

[tool.coverage.run]
branch = true
source = ["{{ package_import_name }}"]
